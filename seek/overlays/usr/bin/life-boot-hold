#!/bin/sh
# LIFE OS: play Ordinary Life on the still-running boot clip.
# Runs after anki-audio-init (speaker is up). Do not load the Hexagon DSP.
#
# Vector's tinyplay cannot skip extra WAV chunks, so this file is a
# canonical 44-byte PCM header. Prefer aplay, which plays the whole song.

WAV=/anki/data/assets/boot-music.wav
[ -f "$WAV" ] || WAV=/anki/data/boot-music.wav

echo "life-boot-hold: play $WAV" > /dev/kmsg 2>/dev/null

if [ -x /usr/bin/aplay ]; then
  aplay -D plughw:0,0 -q "$WAV" && exit 0
  aplay -D hw:0,0 -q "$WAV" && exit 0
  aplay -q "$WAV" && exit 0
fi
if [ -x /usr/bin/tinyplay ]; then
  tinyplay "$WAV" -D 0 -d 0 && exit 0
  tinyplay "$WAV" && exit 0
fi

echo "life-boot-hold: playback failed" > /dev/kmsg 2>/dev/null
exit 0
