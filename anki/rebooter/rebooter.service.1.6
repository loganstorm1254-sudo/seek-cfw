# Service to periodically reboot the robot

[Unit]
Description=Robot Rebooter
After=fake-hwclock.service
Requires=fake-hwclock.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c '[ $(awk "{print int(\$$1)}" /proc/uptime) -gt 3600 ] || exit 1'
ExecStartPre=/bin/sh -c 'echo 1 > /data/maintenance_reboot'
ExecStartPre=/usr/bin/sleep 3
ExecStart=/usr/bin/systemctl reboot
