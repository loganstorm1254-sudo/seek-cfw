	url = https://github.com/Victor-Rebuild/vic-verbose
[submodule "external/purplpkg"]
	path = external/purplpkg
	url = https://github.com/purpl-org/purplpkg
[submodule "anki/victor-1.6"]
	path = anki/victor-1.6
