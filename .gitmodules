	path = anki/wired
	url = https://github.com/Victor-Rebuild/wire_d-1.6-rebuild-2
[submodule "poky/bitbake"]
	path = poky/bitbake
	url = https://github.com/openembedded/bitbake.git
[submodule "poky/openembedded-core"]
	path = poky/openembedded-core
	url = https://github.com/openembedded/openembedded-core.git
[submodule "anki/vic-verbose"]
